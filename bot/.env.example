# ── Discord ───────────────────────────────────────────────────────────────
# From https://discord.com/developers/applications → your app
DISCORD_TOKEN=
CLIENT_ID=
# Optional: register slash commands to one guild instantly (dev). Leave blank
# to register globally (can take up to an hour to propagate).
GUILD_ID=

# Your Discord user ID — pinged by the overheating alert so your phone buzzes.
OWNER_ID=

# ── Overheating monitor ───────────────────────────────────────────────────
# Incoming webhook URL for the channel that should get hardware alerts.
# Channel settings → Integrations → Webhooks → New Webhook → Copy URL
WEBHOOK_URL=
# Alert threshold in °C and how long to stay quiet after an alert (minutes).
TEMP_THRESHOLD_C=85
ALERT_COOLDOWN_MIN=10

# ── CraftPanel Remote API ─────────────────────────────────────────────────
# Where the desktop app's Remote API is listening. Same machine = localhost.
PANEL_URL=http://127.0.0.1:8642
# Bearer token from CraftPanel → Settings → Remote API. If left blank the bot
# auto-reads it from the app's own remote_api.json on this machine.
PANEL_TOKEN=

# ── Moderation ────────────────────────────────────────────────────────────
# Channel ID where /moderation actions (and automod, if on) are logged.
MOD_LOG_CHANNEL_ID=
# Passive automod is OFF by default. Only turn this on if you do NOT already
# run carl-bot / Dyno / Discord AutoMod — two bots deleting messages is bad.
AUTOMOD_ENABLED=false
# Comma-separated regex fragments automod deletes on sight (case-insensitive).
BLOCKED_PATTERNS=discord\.gg\/,free\s+nitro

# ── Join to Create voice channels ─────────────────────────────────────────
# The voice channel a user joins to get their own temporary lobby.
CREATOR_CHANNEL_ID=
# Optional category to create the temporary lobbies under (defaults to the
# creator channel's own category).
LOBBY_CATEGORY_ID=

# ── Verification (scripts/setupServer.ts + events/verify.ts) ──────────────
# Role granted by the "Click to verify" button. Must match what setup-server
# creates. Leave as-is unless you rename the role.
VERIFIED_ROLE_NAME=Verified

# ── Leveling ──────────────────────────────────────────────────────────────
# Path to the SQLite file that stores XP. Relative paths resolve from bot/.
LEVELING_DB_PATH=leveling.sqlite
# Seconds a user must wait between XP-earning messages.
XP_COOLDOWN_SEC=60
